DEBUG=true
SECRET_KEY=change-me
FIELD_ENCRYPTION_KEY=change-me
FIELD_HASH_SECRET=change-me

ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Europe/Moscow

# Local development:
DATABASE_ENGINE=sqlite
SQLITE_DATABASE_NAME=db.sqlite3

# VPS production with local MySQL:
# DATABASE_ENGINE=mysql
# MYSQL_DATABASE=bitrix_reports
# MYSQL_USER=bitrix_reports
# MYSQL_PASSWORD=change-me
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_CONN_MAX_AGE=60

STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media

# Cache backend:
# locmem is only for local fallback.
# redis is required for production report results.
CACHE_BACKEND=locmem
REDIS_URL=redis://127.0.0.1:6379/1
REPORT_SESSION_CACHE_TTL_SECONDS=7200

# HTTPS / reverse proxy. Enable on VPS after nginx + TLS are configured.
USE_X_FORWARDED_HOST=false
SECURE_PROXY_SSL_HEADER=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Bitrix24 apps are usually opened inside an iframe.
X_FRAME_OPTIONS=DENY
ALLOW_IFRAME_EMBED=false

# Bitrix24 REST / OAuth:
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BITRIX_REST_TIMEOUT_SECONDS=30
BITRIX_REST_MAX_LIST_PAGES=200
BITRIX_REST_RETRY_ATTEMPTS=3
BITRIX_REST_RETRY_DELAY_SECONDS=1
REPORT_DATA_PROVIDER=bitrix

# Background report builds:
# Use thread for local development.
# Use celery in production and run a separate celery worker.
REPORT_BACKGROUND_BACKEND=thread
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Monitoring:
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

DEBUG=true
SECRET_KEY=change-me
FIELD_ENCRYPTION_KEY=change-me
FIELD_HASH_SECRET=change-me

ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Europe/Moscow

DATABASE_ENGINE=sqlite
SQLITE_DATABASE_NAME=db.sqlite3

For MySQL / Percona:
DATABASE_ENGINE=mysql
MYSQL_DATABASE=bitrix_reports
MYSQL_USER=bitrix_reports
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60

REPORT_SESSION_CACHE_TTL_SECONDS=7200

# Cache backend:
# locmem is only for local fallback.
# redis is required for production report results.
CACHE_BACKEND=locmem
REDIS_URL=redis://127.0.0.1:6379/1
REPORT_SESSION_CACHE_TTL_SECONDS=7200


# Bitrix24 REST / OAuth:
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BITRIX_REST_TIMEOUT_SECONDS=30
BITRIX_REST_MAX_LIST_PAGES=200